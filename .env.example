# Public application origin
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Supabase (server + browser-safe values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key

# Gemini: server-side only, never expose in browser bundles
GEMINI_API_KEY=replace-with-gemini-key

# Sepolia / wallet integration
SEPOLIA_RPC_URL=https://your-rpc-provider.example
CHAIN_ID=11155111
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Deployment tooling only; never commit or pass to the browser
DEPLOYER_PRIVATE_KEY=replace-only-in-secure-local-shell
ETHERSCAN_API_KEY=replace-with-optional-verification-key

# Optional future operational integrations
SENTRY_DSN=
STORAGE_BUCKET=private-agreements
